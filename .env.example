# VITE_BASE_PATH: Optional base path when deploying to a subpath (e.g. GitHub Pages /repo-name/).
# Defaults to "/" for local development and root domain hosting.
VITE_BASE_PATH="/"

# VITE_CLOUD_SYNC_ENABLED: Future cloud synchronization flag (keep false in local-only mode).
VITE_CLOUD_SYNC_ENABLED="false"
